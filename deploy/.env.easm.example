# Optional EASM integration. Source this file before running ./t4c when
# connecting to an external Neo4j, ICP_Query or GeoIP installation. Systemd
# users can copy the same values into /etc/t4c/t4c.env instead.
T4C_NEO4J_URI=bolt://127.0.0.1:7687
T4C_NEO4J_USER=neo4j
T4C_NEO4J_PASSWORD=replace-with-a-long-random-password
T4C_ICP_ICPQUERY_BASE_URL=http://127.0.0.1:16181
# T4C_ICP_CHINAZ_COOKIE_FILE=/opt/t4c/secrets/chinaz.cookie
# T4C_GEOIP_CITY=/opt/t4c/geoip/dbip-city-lite.mmdb
# T4C_GEOIP_ASN=/opt/t4c/geoip/dbip-asn-lite.mmdb

EASM_LIVE_DOMAIN=
EASM_LIVE_SCAN=0
