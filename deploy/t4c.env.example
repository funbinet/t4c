# Optional overrides for /etc/t4c/config.yaml. Keep this file mode 0640 and
# replace all placeholders before exposing T4C outside localhost.
# T4C_POSTGRES_DSN=postgres://t4c:t4cpassword@127.0.0.1:5432/t4c?sslmode=disable
# T4C_REDIS_URL=redis://:t4cpassword@127.0.0.1:6379/0
# T4C_AUTH_ACCESS_SECRET=replace-with-a-long-random-secret
# T4C_API_KEY_PEPPER=replace-with-a-random-pepper
# T4C_ADMIN_PASSWORD=replace-with-the-initial-admin-password
# T4C_COOKIE_SECURE=true
# T4C_NEO4J_URI=bolt://127.0.0.1:7687
# T4C_NEO4J_USER=neo4j
# T4C_NEO4J_PASSWORD=replace-with-neo4j-password
# T4C_ICP_ICPQUERY_BASE_URL=http://127.0.0.1:16181
# T4C_ICP_CHINAZ_COOKIE_FILE=/opt/t4c/secrets/chinaz.cookie
# T4C_GEOIP_CITY=/opt/t4c/geoip/dbip-city-lite.mmdb
# T4C_GEOIP_ASN=/opt/t4c/geoip/dbip-asn-lite.mmdb
